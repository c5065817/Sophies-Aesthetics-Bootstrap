    <script>


        /* =========================================================
           CONTACT METHOD DOM FUNCTIONALITY
           ========================================================= */


        const emailOption =
            document.querySelector("#contact-email");


        const phoneOption =
            document.querySelector("#contact-phone");


        const emailInput =
            document.querySelector("#email");


        const telephoneInput =
            document.querySelector("#telephone");


        const callbackContainer =
            document.querySelector("#callback-container");


        const callbackTime =
            document.querySelector("#callback-time");



        function updateContactMethod() {


            if (phoneOption.checked) {


                /*
                    Bootstrap uses d-none to hide an element.
                    Remove it when telephone is selected.
                */

                callbackContainer.classList.remove("d-none");


                telephoneInput.required = true;


                callbackTime.required = true;


                emailInput.required = false;


            } else {


                callbackContainer.classList.add("d-none");


                emailInput.required = true;


                telephoneInput.required = false;


                callbackTime.required = false;


                callbackTime.value = "";


            }


        }



        emailOption.addEventListener(
            "change",
            updateContactMethod
        );


        phoneOption.addEventListener(
            "change",
            updateContactMethod
        );



        /* =========================================================
           JAVASCRIPT API
           POSTCODES.IO
           ========================================================= */


        const postcodeInput =
            document.querySelector("#postcode");


        const postcodeButton =
            document.querySelector("#postcode-button");


        const postcodeResult =
            document.querySelector("#postcode-result");



        postcodeButton.addEventListener(
            "click",
            function () {


                const postcode =
                    postcodeInput.value.trim();



                /*
                    Clear previous result classes.
                */

                postcodeResult.className =
                    "mt-2";


                if (postcode === "") {


                    postcodeResult.classList.add(
                        "text-danger"
                    );


                    postcodeResult.textContent =
                        "Please enter a postcode.";


                    return;


                }



                /*
                    Bootstrap spinner displayed while waiting
                    for API response.
                */

                postcodeResult.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>' +
                    'Checking postcode...';



                /*
                    fetch() requests postcode information from
                    the external Postcodes.io API.
                */

                fetch(
                    "https://api.postcodes.io/postcodes/" +
                    encodeURIComponent(postcode)
                )


                    .then(function (response) {


                        if (!response.ok) {


                            throw new Error(
                                "Postcode not found"
                            );


                        }


                        /*
                            Convert API response to JSON.
                        */

                        return response.json();


                    })


                    .then(function (data) {


                        const location =
                            data.result;



                        const district =
                            location.admin_district ||
                            "Unknown district";


                        const region =
                            location.region ||
                            location.country;



                        postcodeResult.className =
                            "alert alert-success mt-3 mb-0";



                        postcodeResult.textContent =
                            "Location found: " +
                            district +
                            ", " +
                            region +
                            ", " +
                            location.country +
                            ".";



                        /*
                            View the complete JSON response
                            through the browser developer console.
                        */

                        console.log(data);


                    })


                    .catch(function (error) {


                        postcodeResult.className =
                            "alert alert-danger mt-3 mb-0";


                        postcodeResult.textContent =
                            "Postcode could not be found. Please check it and try again.";


                        console.error(error);


                    });


            }
        );



        /* =========================================================
           FORM FUNCTIONALITY
           ========================================================= */


        const consultationForm =
            document.querySelector("#consultation-form");


        const formFeedback =
            document.querySelector("#form-feedback");



        consultationForm.addEventListener(
            "submit",
            function (event) {


                /*
                    This is a demonstration application,
                    therefore prevent information being sent.
                */

                event.preventDefault();



                /*
                    Use built-in HTML form validation.
                */

                if (!consultationForm.checkValidity()) {


                    consultationForm.reportValidity();


                    return;


                }



                formFeedback.classList.remove(
                    "d-none"
                );


                formFeedback.textContent =
                    "Thank you. Your demonstration consultation request has been completed successfully. No information has been transmitted or stored.";



                consultationForm.reset();



                postcodeResult.textContent = "";


                postcodeResult.className =
                    "mt-2";


                updateContactMethod();


            }
        );



        /*
            Hide the previous success message when the user
            starts entering another enquiry.
        */

        consultationForm.addEventListener(
            "input",
            function () {


                formFeedback.classList.add(
                    "d-none"
                );


                formFeedback.textContent = "";


            }
        );



        /* =========================================================
           AUTOMATIC COPYRIGHT YEAR
           ========================================================= */


        const currentYear =
            document.querySelector("#current-year");


        currentYear.textContent =
            new Date().getFullYear();



        /*
            Set correct form behaviour when the page loads.
        */

        updateContactMethod();


    </script>


</body>

</html>